---
import Layout from "../../layouts/Layout.astro";
import { promises as fs } from "node:fs";
import path from "node:path";

const FOLDER = "Circle_Square";
const BASE = `/design/${FOLDER}`;
const PUBLIC_DIR = path.join(process.cwd(), "public", "design", FOLDER);

const txtFile = "circle_square.txt";
const subtitle = "XXX - Update";

const isImage = (name: string) => /\.(png|jpe?g|webp|avif|gif|svg)$/i.test(name);

let descriptionText = "";
let imagesInFolder: string[] = [];

try {
  descriptionText = await fs.readFile(path.join(PUBLIC_DIR, txtFile), "utf-8");

  const entries = await fs.readdir(PUBLIC_DIR, { withFileTypes: true });
  imagesInFolder = entries
    .filter((e) => e.isFile() && isImage(e.name))
    .map((e) => e.name);
} catch (err) {
  console.error("[Circle Square page] asset read error:", err);
}

// Ordered Images 01–05
const orderedFiles = [
  "Images-01.webp",
  "Images-02.webp",
  "Images-03.webp",
  "Images-04.webp",
  "Images-05.webp",
  "cover-image.webp",
];

// Case-insensitive match
const byLower = new Map(imagesInFolder.map((n) => [n.toLowerCase(), n]));
const finalFiles = orderedFiles
  .map((n) => byLower.get(n.toLowerCase()))
  .filter(Boolean) as string[];

const galleryImages = finalFiles.map((name) => `${BASE}/${encodeURIComponent(name)}`);

const coverIndex = finalFiles.findIndex((f) => f.toLowerCase() === "cover-image.webp");
const coverSrc = coverIndex >= 0 ? galleryImages[coverIndex] : `${BASE}/cover-image.webp`;

const nonCover = finalFiles
  .map((file, i) => ({ file, src: galleryImages[i], i }))
  .filter((x) => x.file.toLowerCase() !== "cover-image.webp");
---

<Layout title="Circle Within a Square" description="Circle Within a Square project">
  <main class="amp">
    <section class="amp__hero" aria-label="Circle Square hero">
      <div class="amp__inner">

        <figure class="amp__cover" id="coverFigure">
          <button
            class="amp__imgBtn"
            type="button"
            data-lb-index={String(coverIndex >= 0 ? coverIndex : 0)}
            aria-label="Open cover image"
          >
            <img class="amp__img--cover" src={coverSrc} alt="Cover image" loading="eager" decoding="async" />
          </button>

          <div id="coverEnd" aria-hidden="true"></div>
        </figure>

        <header class="amp__meta">
          <h1 class="amp__title">Circle Within a Square</h1>
          <div class="amp__subtitle">{subtitle}</div>
        </header>

        <div class="amp__heroSpacer" aria-hidden="true"></div>
      </div>
    </section>

    <section class="amp__desc" aria-label="Project description">
      <div class="amp__inner">
        {descriptionText ? (
          <div class="amp__body">{descriptionText}</div>
        ) : (
          <div class="amp__body amp__body--error">
            Couldn’t load <code>circle_square.txt</code><br />
            Expected: <code>public/design/{FOLDER}/circle_square.txt</code>
          </div>
        )}
      </div>
    </section>

    <section class="amp__gallery" aria-label="Circle Square gallery">
      <div class="amp__inner">
        <div class="amp__grid amp__grid--gallery">
          {nonCover.map(({ src, i }) => (
            <figure class="amp__galleryItem">
              <button class="amp__imgBtn amp__imgBtn--full" type="button" data-lb-index={String(i)} aria-label="Open image">
                <img class="amp__img--full" src={src} alt="" loading="lazy" decoding="async" />
              </button>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <div id="footerTrigger" aria-hidden="true"></div>

    <!-- Lightbox + Scripts + Styles remain IDENTICAL to Amplitude page -->
    <!-- You can paste the exact same scripts + style block from Amplitude below this point -->

  </main>
</Layout>
